== the width of '%#0Nx' covers the prefix ==
%#x        "0" "0x1" "0xff"
%#5x       "    0" "  0x1" " 0xff"
%#05x      "00000" "0x001" "0x0ff"
%#010x     "0000000000" "0x00000001" "0x000000ff"
%#01x      "0" "0x1" "0xff"
%#02x      "00" "0x1" "0xff"
%#03x      "000" "0x1" "0xff"
%#04x      "0000" "0x01" "0xff"
%#06x      "000000" "0x0001" "0x00ff"
%#-05x     "0    " "0x1  " "0xff "
%#5.0x     "     " "  0x1" " 0xff"
%#05.0x    "     " "  0x1" " 0xff"
%#010.0x   "          " "       0x1" "      0xff"
%#5.1x     "    0" "  0x1" " 0xff"
%#05.1x    "    0" "  0x1" " 0xff"
== the same for '%X' ==
%#X        "0" "0X1" "0XFF"
%#05X      "00000" "0X001" "0X0FF"
%#010X     "0000000000" "0X00000001" "0X000000FF"
%#05.0X    "     " "  0X1" " 0XFF"
%#010.0X   "          " "       0X1" "      0XFF"
== '#' on '%o' keeps the leading zero ==
%#o        "0" "01" "0377"
%#.o       "0" "01" "0377"
%#.0o      "0" "01" "0377"
%#5.o      "    0" "   01" " 0377"
%#05.o     "    0" "   01" " 0377"
%#010.o    "         0" "        01" "      0377"
%#0.o      "0" "01" "0377"
%#0.0o     "0" "01" "0377"
%#-05.o    "0    " "01   " "0377 "
%#5o       "    0" "   01" " 0377"
%#05o      "00000" "00001" "00377"
%#.1o      "0" "01" "0377"
%#.5o      "00000" "00001" "00377"
%#05.5o    "00000" "00001" "00377"
== without '#' the zero and its precision are plain ==
%x         "0" "1" "ff"
%.0x       "" "1" "ff"
%05.0x     "     " "    1" "   ff"
%5.0x      "     " "    1" "   ff"
%05x       "00000" "00001" "000ff"
%#0x       "0" "0x1" "0xff"
%o         "0" "1" "377"
%.0o       "" "1" "377"
%05.0o     "     " "    1" "  377"
%05o       "00000" "00001" "00377"
== a zero written with a precision of zero keeps its sign ==
%.0d       "" "1" "255"
%+.0d      "+" "+1" "+255"
% .0d      " " " 1" " 255"
%+5.0d     "    +" "   +1" " +255"
%-+5.0d    "+    " "+1   " "+255 "
%+05.0d    "    +" "   +1" " +255"
%5.0d      "     " "    1" "  255"
%-5.0d     "     " "1    " "255  "
%05.0d     "     " "    1" "  255"
%+.d       "+" "+1" "+255"
% .d       " " " 1" " 255"
%+3.d      "  +" " +1" "+255"
%+.0i      "+" "+1" "+255"
%+05d      "+0000" "+0001" "+0255"
%+5.0i     "    +" "   +1" " +255"
%.1d       "0" "1" "255"
%+.1d      "+0" "+1" "+255"
== a value that is not zero is unaffected ==
true|"+1"
true|"-1"
true|"-1"
true|"+0"
true|"   +0"
false|"invalid conversion specification: '%+.0x'"
== '#' where it is not allowed ==
false|"invalid conversion specification: '%#d'"
false|"invalid conversion specification: '%#s'"
true|"1.000000"
false|"invalid conversion specification: '%#c'"
done
