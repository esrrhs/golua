goto	refuse: c:1: <name> expected near 'goto'
if	refuse: c:1: <name> expected near 'if'
in	refuse: c:1: <name> expected near 'in'
local	refuse: c:1: <name> expected near 'local'
nil	refuse: c:1: <name> expected near 'nil'
