== names and keywords ==
and	refuse: c:1: <name> expected near 'and'
break	refuse: c:1: <name> expected near 'break'
do	refuse: c:1: <name> expected near 'do'
else	refuse: c:1: <name> expected near 'else'
elseif	refuse: c:1: <name> expected near 'elseif'
