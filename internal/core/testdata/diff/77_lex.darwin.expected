or	refuse: c:1: <name> expected near 'or'
repeat	refuse: c:1: <name> expected near 'repeat'
return	refuse: c:1: <name> expected near 'return'
then	refuse: c:1: <name> expected near 'then'
true	refuse: c:1: <name> expected near 'true'
until	refuse: c:1: <name> expected near 'until'
